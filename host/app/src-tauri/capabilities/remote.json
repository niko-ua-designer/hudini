{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "host-ui",
  "description": "The management page served by the Hudini server (http://localhost:<port>/): may only read and switch autostart.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "permissions": [
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pages bundled with the app (role and sessions screen, loading page, panel, the streamer panel window): core events and the app commands.",
  "webviews": ["main", "panel"],
  "permissions": [
    "core:default",
    "allow-app-state",
    "allow-start-role",
    "allow-set-remember",
    "allow-set-lang",
    "allow-apply-update",
    "allow-store-load",
    "allow-store-save",
    "allow-relay-open",
    "allow-relay-close",
    "allow-relay-status",
    "allow-app-log",
    "allow-open-logs",
    "allow-open-data",
    "allow-crash-dismiss",
    "allow-browser-open",
    "allow-browser-place",
    "allow-browser-visible",
    "allow-browser-close",
    "allow-browser-nav",
    "allow-panel-key",
    "allow-media-support",
    "notification:allow-is-permission-granted"
  ]
}

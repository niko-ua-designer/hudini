{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pages bundled with the app (role and sessions screen, loading page, panel): core events and the app commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-state",
    "allow-start-role",
    "allow-set-remember",
    "allow-apply-update",
    "allow-store-load",
    "allow-store-save",
    "allow-relay-open",
    "allow-relay-close",
    "allow-relay-status",
    "allow-app-log",
    "allow-open-logs",
    "allow-crash-dismiss"
  ]
}

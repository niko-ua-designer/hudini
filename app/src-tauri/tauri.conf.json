{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hudini",
  "version": "1.0.0",
  "identifier": "io.github.nikouadesigner.hudini",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Stream overlay for OBS with a moderator panel",
    "longDescription": "Hudini runs the stream overlay on the streamer's computer or connects a moderator to it directly, without third-party servers.",
    "copyright": "niko-ua-designer",
    "externalBin": [
      "binaries/hudini-server"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
